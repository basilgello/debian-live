deb http://deb.debian.org/debian/ sid main non-free-firmware
deb-src http://deb.debian.org/debian/ sid main non-free-firmware

deb http://security.debian.org/debian-security sid/updates main non-free-firmware
deb-src http://security.debian.org/debian-security sid/updates main non-free-firmware

# sid-updates, previously known as 'volatile'
deb http://deb.debian.org/debian/ sid-updates main non-free-firmware
deb-src http://deb.debian.org/debian/ sid-updates main non-free-firmware

